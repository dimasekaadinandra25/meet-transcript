{
  "manifest_version": 3,
  "name": "Transcripables",
  "version": "0.9.0",
  "description": "Transcribe Google Meet from captions, record Teams, Webex, Slack, Discord, and Zoom web meetings, and turn them into Minutes of Meeting.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabCapture", "offscreen", "activeTab", "contextMenus", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://discord.com/*",
    "https://api.openai.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "rec-start": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Record meeting audio" },
    "rec-start-video": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Record meeting audio + video" },
    "rec-stop": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Stop recording" },
    "mark-moment": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Mark moment" }
  },
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/selectors.js", "content/session.js", "content/captions.js", "content/captionhide.js", "content/captionlang.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "panel/panel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Transcripables",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
