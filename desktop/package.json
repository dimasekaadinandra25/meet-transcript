{
  "name": "transcripables-desktop",
  "productName": "Transcripables",
  "private": true,
  "version": "0.9.0",
  "description": "Record computer audio and microphone from any meeting app, then make a transcript and MoM.",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fetch-engine": "node scripts/fetch-engine.js",
    "build-helper": "node scripts/build-helper.js",
    "dist": "node scripts/fetch-engine.js && node scripts/build-helper.js && electron-builder --win --publish never",
    "dist:dir": "electron-builder --win dir --publish never",
    "dist:mac": "node scripts/fetch-engine.js && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  },
  "author": "Transcripables",
  "build": {
    "appId": "com.transcripables.desktop",
    "productName": "Transcripables",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../lib",
        "to": "lib"
      },
      {
        "from": "../panel",
        "to": "panel"
      },
      {
        "from": "../icons",
        "to": "icons"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "engine",
          "to": "engine"
        },
        {
          "from": "native/bin",
          "to": "native/bin"
        }
      ],
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Transcripables-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Transcripables-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "engine",
          "to": "engine"
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Transcripables records your microphone when you start a recording.",
        "NSAudioCaptureUsageDescription": "Transcripables records computer audio when you start a recording.",
        "NSScreenCaptureUsageDescription": "Transcripables records your screen when you choose audio + video."
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dimasekaadinandra25",
        "repo": "meet-transcript"
      }
    ]
  }
}
